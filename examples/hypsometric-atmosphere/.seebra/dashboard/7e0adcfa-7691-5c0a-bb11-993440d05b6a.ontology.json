        "latitude",
        "longitude",
        "elevation"
      ],
      "in_data": true,
      "children": [
        {
          "cid": "c2",
          "label": "Pressure level",
          "kind": "measure",
          "as": "part",
          "description": "An isobaric surface, hPa; its height is the geopotential height.",
          "fields": [
            "p_hpa",
            "z_m"
          ],
          "in_data": true,
          "children": [
            {
              "cid": "c3",
              "label": "Geopotential height",

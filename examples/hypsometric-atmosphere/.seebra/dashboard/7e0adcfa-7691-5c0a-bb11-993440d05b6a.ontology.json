            "t_k"
          ],
          "in_data": true
        },
        {
          "cid": "c5",
          "label": "Humidity",
          "kind": "measure",
          "as": "property",
          "description": "Water vapour makes air lighter (virtual temperature); not fetched here.",
          "fields": [],
          "in_data": false
        },
        {
          "cid": "c6",
          "label": "Tropopause",
          "kind": "place",
          "as": "part",
          "description": "Where the lapse rate drops below 2 K/km.",
          "fields": [
            "tropopause_m",
            "tropopause_hpa"
          ],
          "in_data": true,
          "wikidata": "Q207976"
        }
      ]
    },
    {
      "cid": "c7",
      "label": "Hypsometric equation",
      "kind": "event",
      "description": "Δz = (R_d/g₀) T̄ ln(p₁/p₂).",

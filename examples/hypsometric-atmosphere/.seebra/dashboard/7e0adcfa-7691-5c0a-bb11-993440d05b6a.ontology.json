{
  "title": "The vertical structure of the atmosphere",
  "summary": "Pressure falls exponentially with height at a rate set by temperature (the hypsometric equation); warm columns are thick, and temperature profiles define the troposphere and the tropopause.",
  "concepts": [
    {
      "cid": "c1",
      "label": "Air column",
      "kind": "place",
      "description": "The atmosphere above one point, here 17 points along 20° E.",

        "dz_hypsometric_m",
        "dz_model_m",
        "error_pct"
      ],
      "in_data": true,
      "wikidata": "Q1638430",
      "facts": [
        {
          "text": "R_d = 287.05 J kg⁻¹ K⁻¹ for dry air.",
          "source": "https://glossary.ametsoc.org/wiki/Gas_constant"
        }
      ],
      "children": [
        {
          "cid": "c8",
          "label": "Scale height",
          "kind": "measure",
          "as": "property",
          "description": "H = R_d T/g₀: the height over which pressure falls by e.",
